# ---------------------------------------------------------------------------
# Jaisy Website — environment variables
# Copy to `.env.local` and adjust. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# Public base URL. Used for metadata, canonical URLs, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Phase 2 (admin panel + database) — not required for the static Phase 1 site.
# ---------------------------------------------------------------------------

# PostgreSQL connection string for Prisma.
# DATABASE_URL=postgresql://user:password@localhost:5432/jaisy?schema=public

# Auth.js / NextAuth secret (generate with `openssl rand -base64 32`).
# AUTH_SECRET=
# AUTH_URL=http://localhost:3000

# Media storage (S3-compatible) for portfolio images and client logos.
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Transactional email for inquiry notifications.
# EMAIL_API_KEY=
# EMAIL_FROM=no-reply@jaisy.example
# EMAIL_TO=info@jaisy.example
